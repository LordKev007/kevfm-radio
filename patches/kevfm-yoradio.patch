diff -ruN -x build -x partitions.csv upstream_yoradio/yoRadio/src/plugins/KevFM/kevfm.cpp yoRadio/src/plugins/KevFM/kevfm.cpp
--- upstream_yoradio/yoRadio/src/plugins/KevFM/kevfm.cpp	1969-12-31 19:00:00.000000000 -0500
+++ yoRadio/src/plugins/KevFM/kevfm.cpp	2026-10-25 22:40:44.686332700 -0400
@@ -0,0 +1,408 @@
+/*
+ * KevFM gift radio plugin for yoRadio. See kevfm.h and README.md.
+ */
+#include "kevfm.h"
+#include "kevfm_station.h"
+#include "kevfm_ota.h"
+#include "kevfm_version.h"
+#include "../../core/options.h"
+#include "../../core/config.h"
+#include "../../core/player.h"
+#include "../../core/network.h"
+#include "../../core/controls.h"
+#include <Preferences.h>
+#include <SPIFFS.h>
+#include "driver/gpio.h"
+#include "driver/rtc_io.h"
+#include "esp_sleep.h"
+#include "esp_mac.h"
+
+KevFM kevfm;
+
+/* ---------------------------------------------------------------- tuning */
+static const uint8_t  kSleepSteps[]       = {0, 10, 15, 30, 60};   /* minutes, 0 = off */
+static const uint32_t KEVFM_COALESCE_MS   = 1000;  /* presses closer than this become one change  */
+static const uint32_t KEVFM_LONGPRESS_MS  = 800;   /* sleep button: hold this long = "time left"  */
+static const uint32_t KEVFM_DEBOUNCE_MS   = 30;
+static const uint32_t KEVFM_TIMER_FADE_MS = 6000;  /* sleep timer reached zero: music fades down  */
+static const uint32_t KEVFM_POWER_FADE_MS = 800;   /* power button held: quick fade               */
+static const uint32_t KEVFM_TOUCH_GLOW_MS = 10000; /* "glow when touched": stays lit this long    */
+static const uint32_t KEVFM_FADE_IN_MS    = 300;
+static const uint32_t KEVFM_FADE_OUT_MS   = 1500;
+static const uint32_t KEVFM_BREATH_MS     = 6000;  /* one breath while the sleep timer runs       */
+static const float    KEVFM_LED_MAX       = 0.60f; /* brightest glow, fraction of full PWM        */
+static const float    KEVFM_BREATH_MIN    = 0.08f;
+static const uint32_t KEVFM_REPLAY_SECS   = 15;    /* stream stopped this long -> play again       */
+static const uint8_t  KEVFM_LED_BITS      = 12;
+static const uint32_t KEVFM_LED_FREQ      = 5000;
+
+static const char* const kClipText[] = {
+  "Sleep timer, ten minutes", "Sleep timer, fifteen minutes", "Sleep timer, thirty minutes",
+  "Sleep timer, sixty minutes", "Sleep timer off", "minutes left",
+  "Light: when touched", "Light on", "Light off"
+};
+
+static inline bool reached(uint32_t now, uint32_t when) { return (int32_t)(now - when) >= 0; }
+
+/* ---------------------------------------------------------------- earliest boot
+   Runs at the end of initArduino(), before setup() and before yoRadio reads any button.
+   The software grounds must be LOW before the encoder / sleep button / LED are used.  */
+extern "C" void initVariant(void) {
+  gpio_deep_sleep_hold_dis();                     /* release the amp-off hold from deep sleep */
+  gpio_hold_dis((gpio_num_t)KEVFM_PIN_AMP_SD);
+  pinMode(KEVFM_PIN_SW_GND_SLEEPBTN, OUTPUT); digitalWrite(KEVFM_PIN_SW_GND_SLEEPBTN, LOW);
+  pinMode(KEVFM_PIN_SW_GND_LED,      OUTPUT); digitalWrite(KEVFM_PIN_SW_GND_LED,      LOW);
+  pinMode(KEVFM_PIN_SW_GND_ENCODER,  OUTPUT); digitalWrite(KEVFM_PIN_SW_GND_ENCODER,  LOW);
+  pinMode(KEVFM_PIN_AMP_SD, INPUT);               /* amp on, (L+R)/2 via the board's divider */
+  pinMode(KEVFM_PIN_LED, OUTPUT); digitalWrite(KEVFM_PIN_LED, LOW);
+  pinMode(KEVFM_PIN_SLEEPBTN, INPUT_PULLUP);
+  rtc_gpio_deinit((gpio_num_t)KEVFM_PIN_POWER);   /* wake pin back to a normal GPIO */
+  /* yoRadio's OneButton objects set these pull-ups in their global constructors, before
+     initArduino() resets the pins, so they are lost. Without them an idle power button reads
+     as held. Set them again here. */
+  pinMode(KEVFM_PIN_POWER, INPUT_PULLUP);
+  pinMode(ENC_BTNB, INPUT_PULLUP);
+  /* Register here, not in the constructor: global constructors run in link order, and if
+     ours runs before pm's, pm's std::vector constructor wipes the registration. All global
+     constructors have finished by the time initVariant() runs. */
+  kevfm.registerNow();
+}
+
+/* ---------------------------------------------------------------- setup hotspot name */
+const char *kevfm_ap_ssid() {
+  static char name[20] = "";
+  if (!name[0]) {
+    uint8_t mac[6] = {0};
+    esp_read_mac(mac, ESP_MAC_WIFI_STA);
+    snprintf(name, sizeof(name), "KevFM-Radio-%02X%02X", mac[4], mac[5]);
+  }
+  return name;
+}
+
+/* ---------------------------------------------------------------- hooks */
+void ctrls_on_loop() { kevfm.loop(); }                                    /* controls.cpp */
+bool kevfm_btn_event(int id, uint8_t kind) { return kevfm.btnEvent(id, kind); } /* KevFM patch */
+void kevfm_on_turn(int8_t delta) { kevfm.onTurn(); }                      /* KevFM patch */
+
+KevFM::KevFM() {}
+
+void KevFM::registerNow() {
+  for (size_t i = 0; i < pm.count(); i++) if (pm.get(i) == this) return;
+  registerPlugin();
+}
+
+void KevFM::on_setup() {
+  Preferences p;
+  if (p.begin("kevfm", true)) {
+    uint8_t m = p.getUChar("light", LIGHT_TOUCHED);
+    _lightMode = m <= LIGHT_OFF ? (kevfmLight_e)m : LIGHT_TOUCHED;
+    p.end();
+  }
+  ledcAttach(KEVFM_PIN_LED, KEVFM_LED_FREQ, KEVFM_LED_BITS);
+  ledcWrite(KEVFM_PIN_LED, 0);
+  Serial.printf("##[KevFM]#\tKevFM radio %s, light mode %d, station %s\n", KEVFM_VERSION, _lightMode, KEVFM_STREAM_URL);
+  _touch();                                       /* glow at power-on, like the original GuSi */
+}
+
+void KevFM::on_connect() { _ensureStation(); }
+
+void KevFM::on_end_setup() {
+  /* KevFM always plays when awake. yoRadio already sent PLAY if smartstart==1. */
+  if (network.status == CONNECTED && config.store.smartstart != 1) {
+    player.sendCommand({PR_PLAY, 1});
+  }
+}
+
+/* The radio has exactly one station. Rewrite the list at every boot if it differs, so the
+   web page's playlist editor can't leave the radio on something else. */
+void KevFM::_ensureStation() {
+  if (config.getMode() != PM_WEB) return;
+  char want[BUFLEN * 2];
+  snprintf(want, sizeof(want), "%s\t%s\t0", KEVFM_STATION_NAME, KEVFM_STREAM_URL);
+  String have;
+  File f = SPIFFS.open(PLAYLIST_PATH, "r");
+  if (f) { have = f.readString(); f.close(); }
+  have.trim();
+  if (have == want) return;
+  f = SPIFFS.open(PLAYLIST_PATH, "w");
+  if (!f) { Serial.println("##[KevFM]#\tcould not write playlist"); return; }
+  f.println(want);
+  f.close();
+  SPIFFS.remove(INDEX_PATH);                       /* yoRadio re-indexes it in initPlaylist() */
+  if (config.store.lastStation != 1) config.saveValue(&config.store.lastStation, (uint16_t)1);
+  Serial.println("##[KevFM]#\tstation list set to KevFM");
+}
+
+/* 1 Hz, main loop (TimeKeeper::loop1) */
+void KevFM::on_ticker() {
+  /* keep playing: if the stream dropped (server restart, network blip), start it again.
+     The wait doubles after each failed try (15 s, 30 s, 1 min, 2 min max) so a station that
+     is off the air for hours isn't hammered; a minute of playing resets it. */
+  static uint16_t replayWait = KEVFM_REPLAY_SECS;
+  static uint16_t playingSecs = 0;
+  if (network.status == CONNECTED && !_fading && !kevfmOtaBusy() && player.status() == STOPPED) {
+    playingSecs = 0;
+    if (++_stoppedSecs >= replayWait) {
+      _stoppedSecs = 0;
+      Serial.printf("##[KevFM]#\tstream stopped, playing again (next wait %u s)\n", replayWait < 60 ? replayWait * 2 : 120);
+      replayWait = replayWait < 60 ? replayWait * 2 : 120;
+      player.sendCommand({PR_PLAY, 1});
+    }
+  } else {
+    _stoppedSecs = 0;
+    if (player.status() == PLAYING && ++playingSecs >= 60) replayWait = KEVFM_REPLAY_SECS;
+  }
+  /* the sleep timer must still put the radio to sleep if yoRadio has paused loopControls
+     (e.g. while the network is lost) */
+  if (_timerRunning() && reached(millis(), _timerEndMs + 2 * KEVFM_TIMER_FADE_MS)) {
+    Serial.println("##[KevFM]#\tsleep timer overdue, sleeping now");
+    _deepSleepNow();
+  }
+}
+
+/* every main-loop pass (ctrls_on_loop) */
+void KevFM::loop() {
+  _webLoop();
+  _sleepBtnLoop();
+  _timerLoop();
+  _fadeLoop();
+  _ledLoop();
+}
+
+/* ---------------------------------------------------------------- touches */
+void KevFM::_touch() {
+  _lastTouchMs = millis();
+}
+
+void KevFM::onTurn() {
+  _lastTurnMs = millis();
+  _touch();
+  if (_fading && _fadeCancelable) _cancelFade();          /* turning the knob cancels a timer fade */
+}
+
+/* Called by the KevFM patch in controls.cpp before yoRadio handles a button.
+   Return true = KevFM handled it, yoRadio does nothing. */
+bool KevFM::btnEvent(int id, uint8_t kind) {
+  _touch();
+  switch ((controlEvt_e)id) {
+    case EVT_ENCBTNB:                               /* knob press: light mode (not play/pause) */
+      if (kind == KEVFM_BTN_CLICK || kind == KEVFM_BTN_DOUBLE) {
+        if (millis() - _lastTurnMs < 700) return true;   /* pressed while turning: ignore */
+        _cycleLight();
+        if (kind == KEVFM_BTN_DOUBLE) _cycleLight();
+      }
+      return true;
+    case EVT_BTNMODE:                               /* power button */
+      if (kind == KEVFM_BTN_LONG_START) {
+        _powerHeld = true;
+        Serial.println("##[KevFM]#\tpower button: going to sleep");
+        _startFadeToSleep(KEVFM_POWER_FADE_MS, false);
+      } else if (kind == KEVFM_BTN_LONG_STOP) {
+        _powerHeld = false;                         /* _fadeLoop sleeps once released + faded */
+      }
+      return true;
+    default:
+      return false;
+  }
+}
+
+/* ---------------------------------------------------------------- sleep timer button */
+void KevFM::_sleepBtnLoop() {
+  uint32_t now = millis();
+  bool raw = digitalRead(KEVFM_PIN_SLEEPBTN) == LOW;
+  if (raw != _sbRaw) { _sbRaw = raw; _sbChangeMs = now; }
+  if (now - _sbChangeMs < KEVFM_DEBOUNCE_MS) return;
+  if (raw && !_sbDown) {                            /* pressed */
+    _sbDown = true; _sbLongDone = false; _sbDownMs = now;
+    _touch();
+  } else if (raw && _sbDown && !_sbLongDone && now - _sbDownMs >= KEVFM_LONGPRESS_MS) {
+    _sbLongDone = true;
+    _sleepBtnLong();
+  } else if (!raw && _sbDown) {                     /* released */
+    _sbDown = false;
+    if (!_sbLongDone) _sleepBtnShort();
+  }
+}
+
+void KevFM::_sleepBtnShort() {
+  uint32_t now = millis();
+  if (_fading && _fadeCancelable) _cancelFade();    /* a press during the timer fade keeps the radio on */
+  _timerIdx = (_timerIdx + 1) % sizeof(kSleepSteps);
+  if (_timerIdx) _timerEndMs = now + (uint32_t)kSleepSteps[_timerIdx] * 60000UL;
+  _coalesceUntil = now + KEVFM_COALESCE_MS;          /* announce only the final setting */
+  _blinkLeft = 0; _blinkOn = false;                  /* stop an older announcement */
+  Serial.printf("##[KevFM]#\tsleep timer -> %u min\n", kSleepSteps[_timerIdx]);
+}
+
+void KevFM::_sleepBtnLong() {
+  _coalesceUntil = 0;
+  if (!_timerRunning()) { _say(CLIP_SLEEP_OFF); return; }
+  uint32_t left = _timerEndMs - millis();
+  if ((int32_t)left < 0) left = 0;
+  _say(CLIP_TIME_LEFT, (uint16_t)((left + 59999UL) / 60000UL));
+}
+
+void KevFM::_timerLoop() {
+  uint32_t now = millis();
+  if (_coalesceUntil && reached(now, _coalesceUntil)) {
+    _coalesceUntil = 0;
+    static const kevfmClip_e clips[] = {CLIP_SLEEP_OFF, CLIP_SLEEP_10, CLIP_SLEEP_15, CLIP_SLEEP_30, CLIP_SLEEP_60};
+    _say(clips[_timerIdx]);
+  }
+  if (_timerRunning() && !_fading && reached(now, _timerEndMs)) {
+    _timerIdx = 0;
+    Serial.println("##[KevFM]#\tsleep timer reached zero");
+    _startFadeToSleep(KEVFM_TIMER_FADE_MS, true);
+  }
+}
+
+/* ---------------------------------------------------------------- fade, amp off, deep sleep */
+void KevFM::_startFadeToSleep(uint32_t fadeMs, bool cancelable) {
+  if (_fading) {                                    /* power button during a timer fade: finish faster */
+    _fadeCancelable = _fadeCancelable && cancelable;
+    if (fadeMs < _fadeMs) _fadeMs = fadeMs;
+    return;
+  }
+  _fading = true;
+  _fadeCancelable = cancelable;
+  _fadeStartMs = millis();
+  _fadeMs = fadeMs;
+  _fadeFromVol = player.getVolume();
+}
+
+void KevFM::_cancelFade() {
+  _fading = false;
+  player.setVolume(_fadeFromVol);
+  Serial.println("##[KevFM]#\tsleep fade cancelled");
+}
+
+void KevFM::_fadeLoop() {
+  if (!_fading) return;
+  uint32_t el = millis() - _fadeStartMs;
+  if (el < _fadeMs) {
+    player.setVolume((uint8_t)((uint32_t)_fadeFromVol * (_fadeMs - el) / _fadeMs));  /* not saved */
+    return;
+  }
+  player.setVolume(0);
+  if (_powerHeld || digitalRead(KEVFM_PIN_POWER) == LOW) return;   /* wait for release, or it wakes at once */
+  _deepSleepNow();
+}
+
+void KevFM::_deepSleepNow() {
+  Serial.println("##[KevFM]#\tamp off, deep sleep (power button wakes)");
+  player.setVolume(0);
+  ledcWrite(KEVFM_PIN_LED, 0);
+  /* amp SD LOW = shutdown, no hiss. GPIO21 is not an RTC pin, so hold it as a digital pad. */
+  pinMode(KEVFM_PIN_AMP_SD, OUTPUT);
+  digitalWrite(KEVFM_PIN_AMP_SD, LOW);
+  gpio_hold_en((gpio_num_t)KEVFM_PIN_AMP_SD);
+  gpio_deep_sleep_hold_en();
+  /* wake on the power button (to real GND); keep its pull-up alive while asleep */
+  esp_sleep_enable_ext0_wakeup((gpio_num_t)KEVFM_PIN_POWER, 0);
+  rtc_gpio_pullup_en((gpio_num_t)KEVFM_PIN_POWER);
+  rtc_gpio_pulldown_dis((gpio_num_t)KEVFM_PIN_POWER);
+  Serial.flush();
+  esp_deep_sleep_start();
+}
+
+/* ---------------------------------------------------------------- status light */
+void KevFM::_cycleLight() {
+  _setLight((kevfmLight_e)((_lightMode + 1) % 3));
+}
+
+void KevFM::_setLight(kevfmLight_e mode) {
+  _lightMode = mode;
+  Preferences p;
+  if (p.begin("kevfm", false)) { p.putUChar("light", _lightMode); p.end(); }
+  static const kevfmClip_e clips[] = {CLIP_LIGHT_TOUCHED, CLIP_LIGHT_ON, CLIP_LIGHT_OFF};
+  _say(clips[_lightMode]);
+}
+
+/* ---------------------------------------------------------------- web page requests */
+uint8_t KevFM::kSleepMinutes(uint8_t idx) { return idx < sizeof(kSleepSteps) ? kSleepSteps[idx] : 0; }
+
+uint32_t KevFM::sleepSecondsLeft() const {
+  if (!_timerIdx) return 0;
+  int32_t left = (int32_t)(_timerEndMs - millis());
+  return left > 0 ? (uint32_t)(left + 999) / 1000 : 0;
+}
+
+void KevFM::_setSleep(uint8_t minutes) {
+  for (uint8_t i = 0; i < sizeof(kSleepSteps); i++) {
+    if (kSleepSteps[i] != minutes) continue;
+    if (_fading && _fadeCancelable) _cancelFade();
+    _timerIdx = i;
+    if (i) _timerEndMs = millis() + (uint32_t)minutes * 60000UL;
+    _coalesceUntil = 0;
+    static const kevfmClip_e clips[] = {CLIP_SLEEP_OFF, CLIP_SLEEP_10, CLIP_SLEEP_15, CLIP_SLEEP_30, CLIP_SLEEP_60};
+    _say(clips[i]);                                  /* the radio confirms, as for the button */
+    Serial.printf("##[KevFM]#\tsleep timer -> %u min (web)\n", minutes);
+    return;
+  }
+}
+
+void KevFM::_webLoop() {
+  int8_t v = webSleep;
+  if (v >= 0) { webSleep = -1; _setSleep((uint8_t)v); _touch(); }
+  v = webLight;
+  if (v >= 0 && v <= LIGHT_OFF) { webLight = -1; _setLight((kevfmLight_e)v); _touch(); }
+  if (restartAt && reached(millis(), restartAt)) {
+    Serial.println("##[KevFM]#\tWi-Fi saved, restarting");
+    config.saveValue(&config.store.lastSSID, (uint8_t)1);   /* try the network just added first */
+    delay(100);
+    ESP.restart();
+  }
+  kevfmWebLoop();
+  kevfmOtaLoop();
+}
+
+/* Spoken clips are a later phase (voice not chosen). Until then the light answers instead:
+   1-4 short blinks = 10/15/30/60 min, one long blink = off; light mode: 1 blink = when touched,
+   2 = always on, long = off; time left: one blink per started 10 minutes. */
+void KevFM::_say(kevfmClip_e clip, uint16_t minutes) {
+  if (clip == CLIP_TIME_LEFT) Serial.printf("##[KevFM]#\tsay: %u %s\n", minutes, kClipText[clip]);
+  else Serial.printf("##[KevFM]#\tsay: %s\n", kClipText[clip]);
+  uint8_t n = 1; bool lng = false;
+  switch (clip) {
+    case CLIP_SLEEP_10: n = 1; break;
+    case CLIP_SLEEP_15: n = 2; break;
+    case CLIP_SLEEP_30: n = 3; break;
+    case CLIP_SLEEP_60: n = 4; break;
+    case CLIP_TIME_LEFT: n = (minutes + 9) / 10; if (n < 1) n = 1; break;
+    case CLIP_LIGHT_TOUCHED: n = 1; break;
+    case CLIP_LIGHT_ON: n = 2; break;
+    case CLIP_SLEEP_OFF:
+    case CLIP_LIGHT_OFF: n = 1; lng = true; break;
+  }
+  _blinkLeft = n; _blinkLong = lng; _blinkOn = false;
+  _blinkNextMs = millis() + 300;                    /* short dark gap so the blinks stand out */
+}
+
+void KevFM::_ledLoop() {
+  uint32_t now = millis();
+  uint32_t dt = now - _lastLedMs;
+  if (dt < 5) return;
+  _lastLedMs = now;
+  float target;
+  bool blinking = _blinkLeft > 0 || _blinkOn;
+  if (blinking) {
+    if (reached(now, _blinkNextMs)) {
+      if (_blinkOn) { _blinkOn = false; _blinkLeft--; _blinkNextMs = now + 300; }
+      else if (_blinkLeft) { _blinkOn = true; _blinkNextMs = now + (_blinkLong ? 1000 : 250); }
+    }
+    _level = _blinkOn ? 1.0f : 0.0f;
+    if (!_blinkLeft && !_blinkOn) _lastTouchMs = now;  /* settle back from a fresh "touch" */
+  } else {
+    if (_lightMode == LIGHT_OFF) target = 0;
+    else if (_timerRunning()) {
+      float ph = (float)(now % KEVFM_BREATH_MS) / KEVFM_BREATH_MS;
+      target = KEVFM_BREATH_MIN + (1.0f - KEVFM_BREATH_MIN) * (0.5f - 0.5f * cosf(2 * PI * ph));
+    }
+    else if (_lightMode == LIGHT_ALWAYS) target = 1;
+    else target = (now - _lastTouchMs < KEVFM_TOUCH_GLOW_MS) ? 1 : 0;
+    if (target > _level) { _level += (float)dt / KEVFM_FADE_IN_MS;  if (_level > target) _level = target; }
+    else                 { _level -= (float)dt / KEVFM_FADE_OUT_MS; if (_level < target) _level = target; }
+  }
+  float g = _level * _level * KEVFM_LED_MAX;          /* rough gamma so fades look even */
+  ledcWrite(KEVFM_PIN_LED, (uint32_t)(g * ((1 << KEVFM_LED_BITS) - 1)));
+}
diff -ruN -x build -x partitions.csv upstream_yoradio/yoRadio/src/plugins/KevFM/kevfm.h yoRadio/src/plugins/KevFM/kevfm.h
--- upstream_yoradio/yoRadio/src/plugins/KevFM/kevfm.h	1969-12-31 19:00:00.000000000 -0500
+++ yoRadio/src/plugins/KevFM/kevfm.h	2026-10-25 17:50:55.405758000 -0400
@@ -0,0 +1,111 @@
+/*
+ * KevFM gift radio plugin for yoRadio.
+ *
+ * Owns: software grounds (D18/D19/D22), amp SD (D21), sleep-timer button (D13),
+ * status light (D2), knob press (light mode), power-button sleep, KevFM-only station,
+ * always-play. See E:\KevinFM\dev\gusi_radio_handwired\firmware_spec.md
+ *
+ * Needs the small "KevFM patch" in src/core/controls.cpp (kevfm_btn_event / kevfm_on_turn hooks).
+ */
+#ifndef KEVFM_H
+#define KEVFM_H
+
+#include "../../pluginsManager/pluginsManager.h"
+
+/*  Pins  */
+#define KEVFM_PIN_SW_GND_SLEEPBTN  18   /* sleep button's ground  */
+#define KEVFM_PIN_SW_GND_LED       19   /* LED cathode            */
+#define KEVFM_PIN_SW_GND_ENCODER   22   /* KY-040 GND             */
+#define KEVFM_PIN_AMP_SD           21   /* INPUT = on, OUTPUT LOW = off, never HIGH */
+#define KEVFM_PIN_SLEEPBTN         13   /* to D18, internal pull-up */
+#define KEVFM_PIN_LED               2   /* -> 220R -> LED -> D19   */
+#define KEVFM_PIN_POWER             4   /* power/wake, real GND (yoRadio BTN_MODE / WAKE_PIN) */
+
+/*  Things a listener should hear. Until the clips exist (voice not chosen yet) each one is
+    shown as a blink pattern on the status light instead.  */
+enum kevfmClip_e : uint8_t {
+  CLIP_SLEEP_10, CLIP_SLEEP_15, CLIP_SLEEP_30, CLIP_SLEEP_60, CLIP_SLEEP_OFF,
+  CLIP_TIME_LEFT,                   /* "Twenty-two minutes left" (minutes passed separately) */
+  CLIP_LIGHT_TOUCHED, CLIP_LIGHT_ON, CLIP_LIGHT_OFF
+};
+
+enum kevfmLight_e : uint8_t { LIGHT_TOUCHED = 0, LIGHT_ALWAYS = 1, LIGHT_OFF = 2 };
+
+class KevFM : public Plugin {
+public:
+  KevFM();
+  void registerNow();               /* called from initVariant(), see kevfm.cpp */
+  void on_setup();
+  void on_connect();
+  void on_end_setup();
+  void on_ticker();
+
+  /*  Called from the main loop (ctrls_on_loop) and from the controls.cpp patch  */
+  void loop();
+  bool btnEvent(int id, uint8_t kind);
+  void onTurn();
+
+  /*  Web page (kevfm_web.cpp). Requests arrive on the web server's task, so they only leave
+      a request here; loop() carries it out on the main loop.  */
+  volatile int8_t   webSleep = -1;     /* minutes 0/10/15/30/60, -1 = none */
+  volatile int8_t   webLight = -1;     /* kevfmLight_e, -1 = none */
+  volatile uint32_t restartAt = 0;     /* millis() to restart at (after saving Wi-Fi), 0 = none */
+  uint8_t  lightMode() const { return _lightMode; }
+  uint8_t  sleepSetting() const { return kSleepMinutes(_timerIdx); }
+  uint32_t sleepSecondsLeft() const;
+  static uint8_t kSleepMinutes(uint8_t idx);
+
+private:
+  /* sleep timer */
+  uint8_t  _timerIdx = 0;            /* index into kSleepSteps, 0 = off */
+  uint32_t _timerEndMs = 0;
+  uint32_t _coalesceUntil = 0;       /* announce the setting when this passes */
+  bool     _sbDown = false, _sbLongDone = false;
+  uint32_t _sbChangeMs = 0, _sbDownMs = 0;
+  bool     _sbRaw = false;
+  /* light */
+  kevfmLight_e _lightMode = LIGHT_TOUCHED;
+  uint32_t _lastTouchMs = 0;
+  float    _level = 0;               /* 0..1 current brightness */
+  uint32_t _lastLedMs = 0;
+  /* blink announcement (stand-in for spoken clips) */
+  uint8_t  _blinkLeft = 0;
+  bool     _blinkLong = false;
+  uint32_t _blinkNextMs = 0;
+  bool     _blinkOn = false;
+  /* knob */
+  uint32_t _lastTurnMs = 0;
+  /* sleep / fade */
+  bool     _fading = false;
+  bool     _fadeCancelable = false;   /* timer fade: any touch keeps the radio on */
+  uint32_t _fadeStartMs = 0, _fadeMs = 0;
+  uint8_t  _fadeFromVol = 0;
+  bool     _powerHeld = false;
+  /* keep playing */
+  uint16_t _stoppedSecs = 0;
+
+  void _touch();
+  void _sleepBtnLoop();
+  void _sleepBtnShort();
+  void _sleepBtnLong();
+  void _timerLoop();
+  void _ledLoop();
+  void _say(kevfmClip_e clip, uint16_t minutes = 0);
+  void _cycleLight();
+  void _startFadeToSleep(uint32_t fadeMs, bool cancelable);
+  void _cancelFade();
+  void _fadeLoop();
+  void _deepSleepNow();
+  void _ensureStation();
+  void _setSleep(uint8_t minutes);
+  void _setLight(kevfmLight_e mode);
+  void _webLoop();
+  bool _timerRunning() { return _timerIdx != 0; }
+};
+
+extern KevFM kevfm;
+
+/* kevfm_web.cpp */
+void kevfmWebLoop();     /* captive DNS + first Wi-Fi scan while in hotspot mode */
+
+#endif
diff -ruN -x build -x partitions.csv upstream_yoradio/yoRadio/src/plugins/KevFM/kevfm_ota.cpp yoRadio/src/plugins/KevFM/kevfm_ota.cpp
--- upstream_yoradio/yoRadio/src/plugins/KevFM/kevfm_ota.cpp	1969-12-31 19:00:00.000000000 -0500
+++ yoRadio/src/plugins/KevFM/kevfm_ota.cpp	2026-10-25 22:22:54.225402300 -0400
@@ -0,0 +1,416 @@
+/*
+ * KevFM radio firmware updates, the same way as the Bubs stock ticker: nothing happens
+ * unless someone presses a button on the radio's Firmware page.
+ *
+ *   POST /kevfm/update/check     read update.json from GitHub (raw file), compare versions
+ *   POST /kevfm/update/install   download the newer .bin (+ any web files listed), restart
+ *   POST /kevfm/update/upload    install a .bin file sent from the browser (no GitHub needed)
+ *   GET  /kevfm/update/status    state, message, versions, progress
+ *
+ * update.json:  {"version": "0.2.1", "file": "kevfm-radio.bin", "size": 1484051,
+ *                "web": ["kevfm.html", "setup.html", "firmware.html"]}
+ *   "file" is a plain file name in the repo root; "size" and "web" are optional. Web files
+ *   come from the repo's yoRadio/data/www/ and replace the radio's copies (saved Wi-Fi is
+ *   never touched).
+ *
+ * Check and install run on the main loop (the web request only queues them and returns),
+ * with the stream stopped while installing: this board has no PSRAM, and https needs the
+ * memory the stream buffer uses.
+ */
+#include "kevfm.h"
+#include "kevfm_ota.h"
+#include "kevfm_version.h"
+#include "../../core/options.h"
+#include "../../core/config.h"
+#include "../../core/player.h"
+#include "../../core/network.h"
+#include <WiFi.h>
+#include <WiFiClientSecure.h>
+#include <HTTPClient.h>
+#include <Update.h>
+#include <SPIFFS.h>
+#include <errno.h>
+
+enum otaState_e : uint8_t { OTA_IDLE, OTA_CHECKING, OTA_CHECKED, OTA_INSTALLING, OTA_DONE, OTA_FAILED };
+static const char *const kStateName[] = {"idle", "checking", "checked", "installing", "done", "failed"};
+
+static portMUX_TYPE otaMux = portMUX_INITIALIZER_UNLOCKED;
+static volatile otaState_e otaState = OTA_IDLE;
+static volatile bool checkQueued = false, installQueued = false, uploadActive = false;
+static volatile uint8_t otaProgress = 0;
+static volatile uint32_t otaRestartAt = 0;
+static char otaMessage[160] = "";
+static char latestVersion[24] = "";
+static char latestFile[64] = "";
+static uint32_t latestSize = 0;
+static bool updateAvailable = false;
+static const uint8_t KEVFM_MAX_WEB = 8;
+static String webFiles[KEVFM_MAX_WEB];
+static uint8_t webCount = 0;
+static bool uploadOk = false;
+static char uploadError[96] = "";
+
+static void setMsg(otaState_e st, const char *fmt, ...) {
+  char buf[sizeof(otaMessage)];
+  va_list ap; va_start(ap, fmt); vsnprintf(buf, sizeof(buf), fmt, ap); va_end(ap);
+  portENTER_CRITICAL(&otaMux);
+  otaState = st;
+  strlcpy(otaMessage, buf, sizeof(otaMessage));
+  portEXIT_CRITICAL(&otaMux);
+  Serial.printf("##[KevFM]#\tupdate: %s\n", buf);
+}
+
+bool kevfmOtaBusy() {
+  return otaState == OTA_CHECKING || otaState == OTA_INSTALLING || checkQueued || installQueued || uploadActive || otaRestartAt;
+}
+
+/* ---------------------------------------------------------------- tiny JSON readers */
+static bool jsonString(const String &js, const char *key, String &out) {
+  String k = String("\"") + key + "\"";
+  int i = js.indexOf(k); if (i < 0) return false;
+  i = js.indexOf(':', i + k.length()); if (i < 0) return false;
+  i = js.indexOf('"', i); if (i < 0) return false;
+  int j = js.indexOf('"', i + 1); if (j < 0) return false;
+  out = js.substring(i + 1, j);
+  return true;
+}
+
+static bool jsonUInt(const String &js, const char *key, uint32_t &out) {
+  String k = String("\"") + key + "\"";
+  int i = js.indexOf(k); if (i < 0) return false;
+  i = js.indexOf(':', i + k.length()); if (i < 0) return false;
+  i++;
+  while (i < (int)js.length() && js[i] == ' ') i++;
+  if (i >= (int)js.length() || !isDigit(js[i])) return false;
+  out = (uint32_t)js.substring(i).toInt();
+  return true;
+}
+
+static uint8_t jsonStringArray(const String &js, const char *key, String out[], uint8_t max) {
+  String k = String("\"") + key + "\"";
+  int i = js.indexOf(k); if (i < 0) return 0;
+  i = js.indexOf('[', i + k.length()); if (i < 0) return 0;
+  int end = js.indexOf(']', i); if (end < 0) return 0;
+  uint8_t n = 0;
+  while (n < max) {
+    int a = js.indexOf('"', i); if (a < 0 || a > end) break;
+    int b = js.indexOf('"', a + 1); if (b < 0 || b > end) break;
+    out[n++] = js.substring(a + 1, b);
+    i = b + 1;
+  }
+  return n;
+}
+
+static bool plainName(const String &s) {
+  return s.length() > 0 && s.length() < 48 && s.indexOf("..") < 0 && s.indexOf('/') < 0 &&
+         s.indexOf('\\') < 0 && s.indexOf(':') < 0;
+}
+
+/* "0.2.10" > "0.2.9"; a leading v and anything after '-' are ignored */
+static int compareVersions(String a, String b) {
+  for (String *s : {&a, &b}) {
+    s->trim();
+    if (s->startsWith("v") || s->startsWith("V")) s->remove(0, 1);
+    int d = s->indexOf('-'); if (d >= 0) *s = s->substring(0, d);
+  }
+  int pa = 0, pb = 0;
+  for (int part = 0; part < 3; part++) {
+    int ea = a.indexOf('.', pa), eb = b.indexOf('.', pb);
+    long va = a.substring(pa, ea < 0 ? a.length() : ea).toInt();
+    long vb = b.substring(pb, eb < 0 ? b.length() : eb).toInt();
+    if (va != vb) return va < vb ? -1 : 1;
+    pa = ea < 0 ? a.length() : ea + 1;
+    pb = eb < 0 ? b.length() : eb + 1;
+  }
+  return 0;
+}
+
+/* ---------------------------------------------------------------- stream pause */
+static bool stopStream() {
+  bool was = player.status() == PLAYING;
+  if (was) {
+    player.sendCommand({PR_STOP, 0});
+    player.loop();                                  /* we are on the main loop: run it now */
+    delay(300);
+  }
+  return was;
+}
+
+/* ---------------------------------------------------------------- check */
+static void doCheck() {
+  setMsg(OTA_CHECKING, "Checking GitHub for new firmware...");
+  if (WiFi.status() != WL_CONNECTED) { setMsg(OTA_FAILED, "The radio is not connected to the Internet."); return; }
+  uint32_t big = ESP.getMaxAllocHeap();
+  bool paused = false;
+  if (big < 45000) paused = stopStream();           /* not enough room for https while streaming */
+  Serial.printf("##[KevFM]#\tupdate check: largest free block %u bytes%s\n", big, paused ? ", stream paused" : "");
+
+  WiFiClientSecure client;
+  client.setInsecure();                             /* as the ticker: plain raw.githubusercontent.com */
+  HTTPClient http;
+  http.setReuse(false);
+  http.setTimeout(12000);
+  String payload;
+  int code = -1;
+  if (http.begin(client, KEVFM_UPDATE_MANIFEST)) {
+    code = http.GET();
+    if (code == HTTP_CODE_OK) payload = http.getString();
+    http.end();
+  }
+  client.stop();
+  if (paused) player.sendCommand({PR_PLAY, 1});
+
+  if (code != HTTP_CODE_OK) {
+    if (code < 0) setMsg(OTA_FAILED, "Couldn't reach GitHub (%s). You can still upload a .bin file below.", HTTPClient::errorToString(code).c_str());
+    else setMsg(OTA_FAILED, "GitHub answered HTTP %d for update.json. You can still upload a .bin file below.", code);
+    return;
+  }
+  String ver, file;
+  uint32_t size = 0;
+  if (!jsonString(payload, "version", ver) || !ver.length()) { setMsg(OTA_FAILED, "update.json has no version."); return; }
+  if (!jsonString(payload, "file", file)) file = "kevfm-radio.bin";
+  file.trim();
+  if (!plainName(file) || !file.endsWith(".bin")) { setMsg(OTA_FAILED, "update.json has an invalid file name."); return; }
+  jsonUInt(payload, "size", size);
+  String web[KEVFM_MAX_WEB];
+  uint8_t nweb = jsonStringArray(payload, "web", web, KEVFM_MAX_WEB);
+  for (uint8_t i = 0; i < nweb; i++) if (!plainName(web[i])) { setMsg(OTA_FAILED, "update.json has an invalid web file name."); return; }
+
+  int cmp = compareVersions(ver, KEVFM_VERSION);
+  portENTER_CRITICAL(&otaMux);
+  strlcpy(latestVersion, ver.c_str(), sizeof(latestVersion));
+  strlcpy(latestFile, file.c_str(), sizeof(latestFile));
+  latestSize = size;
+  updateAvailable = cmp > 0;
+  portEXIT_CRITICAL(&otaMux);
+  webCount = nweb;
+  for (uint8_t i = 0; i < nweb; i++) webFiles[i] = web[i];
+  if (cmp > 0) setMsg(OTA_CHECKED, "Version %s is available (this radio has %s).", ver.c_str(), KEVFM_VERSION);
+  else if (cmp == 0) setMsg(OTA_CHECKED, "This radio already has the latest firmware (%s).", KEVFM_VERSION);
+  else setMsg(OTA_CHECKED, "This radio (%s) is newer than the published firmware (%s).", KEVFM_VERSION, ver.c_str());
+}
+
+/* ---------------------------------------------------------------- install */
+static bool download(const String &url, const char *what, uint32_t expect, bool toFlash, const char *spiffsPath) {
+  WiFiClientSecure client;
+  client.setInsecure();
+  client.setTimeout(15000);
+  HTTPClient http;
+  http.setReuse(false);
+  http.setTimeout(15000);
+  if (!http.begin(client, url)) { setMsg(OTA_FAILED, "Couldn't open the %s download.", what); return false; }
+  int code = http.GET();
+  if (code != HTTP_CODE_OK) {
+    if (code < 0) setMsg(OTA_FAILED, "%s download failed: %s.", what, HTTPClient::errorToString(code).c_str());
+    else setMsg(OTA_FAILED, "GitHub answered HTTP %d for the %s.", code, what);
+    http.end(); client.stop(); return false;
+  }
+  int len = http.getSize();
+  uint32_t room = ESP.getFreeSketchSpace() & 0xFFFFF000;
+  File f;
+  if (toFlash) {
+    if ((len > 0 && (uint32_t)len > room) || (expect && expect > room)) { setMsg(OTA_FAILED, "The new firmware is too big for this radio."); http.end(); client.stop(); return false; }
+    if (!Update.begin(len > 0 ? (uint32_t)len : room, U_FLASH)) { setMsg(OTA_FAILED, "Couldn't start writing the firmware (error %u).", Update.getError()); http.end(); client.stop(); return false; }
+  } else {
+    f = SPIFFS.open(spiffsPath, "w");
+    if (!f) { setMsg(OTA_FAILED, "Couldn't save %s.", what); http.end(); client.stop(); return false; }
+  }
+  WiFiClient *stream = http.getStreamPtr();
+  uint8_t buf[1024];
+  size_t written = 0;
+  uint32_t lastData = millis();
+  bool failed = false;
+  int lastPct = -1;
+  while ((http.connected() || stream->available()) && (len < 0 || written < (size_t)len)) {
+    size_t avail = stream->available();
+    if (!avail) {
+      if (millis() - lastData > 15000) { setMsg(OTA_FAILED, "The %s download timed out.", what); failed = true; break; }
+      delay(1);
+      continue;
+    }
+    int n = stream->readBytes((char *)buf, avail > sizeof(buf) ? sizeof(buf) : avail);
+    if (n <= 0) { setMsg(OTA_FAILED, "The %s download stopped.", what); failed = true; break; }
+    size_t w = toFlash ? Update.write(buf, n) : f.write(buf, n);
+    if (w != (size_t)n) {
+      if (toFlash) setMsg(OTA_FAILED, "Writing the firmware failed (error %u).", Update.getError());
+      else setMsg(OTA_FAILED, "Saving %s failed after %u of %d bytes (wrote %u of %d; storage %u of %u bytes used, errno %d).",
+                  what, (unsigned)written, len, (unsigned)w, n, (unsigned)SPIFFS.usedBytes(), (unsigned)SPIFFS.totalBytes(), errno);
+      failed = true;
+      break;
+    }
+    written += w;
+    lastData = millis();
+    if (toFlash && len > 0) {
+      int pct = (int)(written * 100ULL / (size_t)len);
+      otaProgress = pct > 99 ? 99 : pct;
+      if (pct / 10 != lastPct) { lastPct = pct / 10; setMsg(OTA_INSTALLING, "Downloading firmware: %d%%", pct); }
+    }
+  }
+  http.end();
+  client.stop();
+  if (!failed && len > 0 && written != (size_t)len) { setMsg(OTA_FAILED, "The %s download ended early.", what); failed = true; }
+  if (toFlash) {
+    if (failed) { Update.abort(); return false; }
+    if (!Update.end(true)) { setMsg(OTA_FAILED, "The new firmware didn't check out (error %u). Nothing was changed.", Update.getError()); return false; }
+  } else {
+    f.close();
+    if (failed) { SPIFFS.remove(spiffsPath); return false; }
+  }
+  return true;
+}
+
+static void doInstall() {
+  char file[sizeof(latestFile)], ver[sizeof(latestVersion)];
+  uint32_t size;
+  bool avail;
+  portENTER_CRITICAL(&otaMux);
+  strlcpy(file, latestFile, sizeof(file)); strlcpy(ver, latestVersion, sizeof(ver));
+  size = latestSize; avail = updateAvailable;
+  portEXIT_CRITICAL(&otaMux);
+  if (!avail) { setMsg(OTA_FAILED, "Check for an update first."); return; }
+  if (WiFi.status() != WL_CONNECTED) { setMsg(OTA_FAILED, "The radio is not connected to the Internet."); return; }
+  otaProgress = 0;
+  setMsg(OTA_INSTALLING, "Stopping the music for the update...");
+  stopStream();
+  Serial.printf("##[KevFM]#\tupdate install: largest free block %u bytes, storage %u of %u bytes used\n",
+                ESP.getMaxAllocHeap(), (unsigned)SPIFFS.usedBytes(), (unsigned)SPIFFS.totalBytes());
+
+  /* web files first, to temporary names; they replace the old ones only if the firmware
+     installs too, so pages and firmware stay matched */
+  for (uint8_t i = 0; i < webCount; i++) {
+    setMsg(OTA_INSTALLING, "Downloading web page %s...", webFiles[i].c_str());
+    String tmp = "/www/" + webFiles[i] + ".new";
+    if (!download(String(KEVFM_UPDATE_BASE) + KEVFM_UPDATE_WEBDIR + webFiles[i], webFiles[i].c_str(), 0, false, tmp.c_str())) {
+      for (uint8_t j = 0; j <= i; j++) SPIFFS.remove("/www/" + webFiles[j] + ".new");
+      player.sendCommand({PR_PLAY, 1});
+      return;
+    }
+  }
+  setMsg(OTA_INSTALLING, "Downloading firmware %s...", ver);
+  if (!download(String(KEVFM_UPDATE_BASE) + file, "firmware", size, true, nullptr)) {
+    for (uint8_t j = 0; j < webCount; j++) SPIFFS.remove("/www/" + webFiles[j] + ".new");
+    player.sendCommand({PR_PLAY, 1});
+    return;
+  }
+  for (uint8_t i = 0; i < webCount; i++) {
+    String fin = "/www/" + webFiles[i];
+    SPIFFS.remove(fin);
+    SPIFFS.rename(fin + ".new", fin);
+  }
+  otaProgress = 100;
+  setMsg(OTA_DONE, "Version %s installed. The radio is restarting...", ver);
+  otaRestartAt = millis() + 2500;                   /* let the page see "done" first */
+}
+
+/* main loop */
+void kevfmOtaLoop() {
+  if (checkQueued) { checkQueued = false; doCheck(); }
+  if (installQueued) { installQueued = false; doInstall(); }
+  if (otaRestartAt && (int32_t)(millis() - otaRestartAt) >= 0) {
+    Serial.println("##[KevFM]#\tupdate: restarting");
+    delay(100);
+    ESP.restart();
+  }
+}
+
+/* ---------------------------------------------------------------- web handlers */
+static void sendJson(AsyncWebServerRequest *request, const String &json, int code = 200) {
+  AsyncWebServerResponse *r = request->beginResponse(code, "application/json", json);
+  r->addHeader("Cache-Control", "no-store");
+  request->send(r);
+}
+
+static void addEscaped(String &out, const char *s) {
+  out += '"';
+  for (; *s; s++) {
+    if (*s == '"' || *s == '\\') out += '\\';
+    if ((uint8_t)*s >= 0x20) out += *s;
+  }
+  out += '"';
+}
+
+static void onStatus(AsyncWebServerRequest *request) {
+  char msg[sizeof(otaMessage)], ver[sizeof(latestVersion)];
+  bool avail; uint32_t size; otaState_e st;
+  portENTER_CRITICAL(&otaMux);
+  strlcpy(msg, otaMessage, sizeof(msg)); strlcpy(ver, latestVersion, sizeof(ver));
+  avail = updateAvailable; size = latestSize; st = otaState;
+  portEXIT_CRITICAL(&otaMux);
+  if (checkQueued) st = OTA_CHECKING;
+  if (installQueued) st = OTA_INSTALLING;
+  String out = "{\"state\":\"";
+  out += kStateName[st];
+  out += "\",\"message\":"; addEscaped(out, msg);
+  out += ",\"current\":\"" KEVFM_VERSION "\",\"latest\":"; addEscaped(out, ver);
+  out += ",\"available\":"; out += avail ? "true" : "false";
+  out += ",\"size\":"; out += size;
+  out += ",\"progress\":"; out += otaProgress;
+  out += ",\"repo\":\"" KEVFM_UPDATE_BASE "\"}";
+  sendJson(request, out);
+}
+
+static void onCheck(AsyncWebServerRequest *request) {
+  if (kevfmOtaBusy()) { sendJson(request, "{\"ok\":false,\"error\":\"An update is already running.\"}", 409); return; }
+  checkQueued = true;
+  sendJson(request, "{\"ok\":true}");
+}
+
+static void onInstall(AsyncWebServerRequest *request) {
+  if (kevfmOtaBusy()) { sendJson(request, "{\"ok\":false,\"error\":\"An update is already running.\"}", 409); return; }
+  if (!updateAvailable) { sendJson(request, "{\"ok\":false,\"error\":\"Check for an update first.\"}", 409); return; }
+  installQueued = true;
+  sendJson(request, "{\"ok\":true}");
+}
+
+/* manual .bin upload: runs on the web server's task, like yoRadio's own /update */
+static void onUploadData(AsyncWebServerRequest *request, String filename, size_t index, uint8_t *data, size_t len, bool final) {
+  if (!index) {
+    uploadOk = false; uploadError[0] = 0;
+    if (otaState == OTA_INSTALLING || checkQueued || installQueued || otaRestartAt) { strlcpy(uploadError, "An update is already running.", sizeof(uploadError)); return; }
+    uploadActive = true;
+    otaProgress = 0;
+    setMsg(OTA_INSTALLING, "Receiving %s...", filename.c_str());
+    player.sendCommand({PR_STOP, 0});
+    if (!Update.begin(UPDATE_SIZE_UNKNOWN, U_FLASH)) {
+      snprintf(uploadError, sizeof(uploadError), "Couldn't start writing the firmware (error %u).", Update.getError());
+      uploadActive = false;
+      return;
+    }
+  }
+  if (!uploadActive || uploadError[0]) return;
+  if (len && Update.write(data, len) != len) {
+    snprintf(uploadError, sizeof(uploadError), "Writing the firmware failed (error %u).", Update.getError());
+    Update.abort();
+    uploadActive = false;
+    return;
+  }
+  size_t total = request->contentLength();
+  if (total) otaProgress = (uint8_t)min((size_t)99, (index + len) * 100 / total);
+  if (final) {
+    if (Update.end(true)) uploadOk = true;
+    else snprintf(uploadError, sizeof(uploadError), "That file isn't valid firmware for this radio (error %u). Nothing was changed.", Update.getError());
+    uploadActive = false;
+  }
+}
+
+static void onUploadDone(AsyncWebServerRequest *request) {
+  if (uploadOk) {
+    otaProgress = 100;
+    setMsg(OTA_DONE, "Firmware file installed. The radio is restarting...");
+    otaRestartAt = millis() + 2500;
+    sendJson(request, "{\"ok\":true}");
+  } else {
+    const char *err = uploadError[0] ? uploadError : "The upload didn't arrive.";
+    setMsg(OTA_FAILED, "%s", err);
+    player.sendCommand({PR_PLAY, 1});
+    String out = "{\"ok\":false,\"error\":"; addEscaped(out, err); out += '}';
+    sendJson(request, out, 400);
+  }
+}
+
+void kevfmOtaBegin(AsyncWebServer &server) {
+  server.on("/kevfm/update/status", HTTP_GET, onStatus);
+  server.on("/kevfm/update/check", HTTP_POST, onCheck);
+  server.on("/kevfm/update/install", HTTP_POST, onInstall);
+  server.on("/kevfm/update/upload", HTTP_POST, onUploadDone, onUploadData);
+}
